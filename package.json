{
  "name": "hushh-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "setup:local-db": "bash scripts/setup-local-db.sh",
    "smoke:test": "ADMIN_MATCHER_SEED_ENABLED=true node scripts/smoke-test.js",
    "matching-policy:test": "ADMIN_MATCHER_SEED_ENABLED=true node scripts/matching-policy-test.js",
    "commitment-threshold:test": "node scripts/commitment-threshold-test.js",
    "refund-deadline:test": "node scripts/refund-deadline-test.js",
    "past-meets:test": "ADMIN_MATCHER_SEED_ENABLED=true node scripts/past-meets-test.js",
    "auth-hardening:test": "node scripts/auth-hardening-test.js",
    "readiness:test": "ADMIN_MATCHER_SEED_ENABLED=true node scripts/readiness-idempotency-test.js",
    "openapi:check": "node scripts/openapi-check.js",
    "pilot:qa": "bash scripts/pilot-qa-chain.sh",
    "pilot:qa:local": "bash scripts/pilot-qa-local.sh",
    "pilot:config-check": "bash scripts/pilot-config-check.sh",
    "pilot:health-check": "bash scripts/pilot-health-check.sh",
    "pilot:cloud-safe:test": "node scripts/pilot-cloud-safe-test.js",
    "pilot:admin-ops:test": "node scripts/pilot-admin-ops-check.js"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1"
  },
  "devDependencies": {
    "prisma": "^6.3.1"
  }
}
