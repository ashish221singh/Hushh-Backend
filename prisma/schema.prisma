generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model VerificationRequest {
  requestId       String @id
  countryCode     String
  phone           String
  normalizedPhone String
  token           String @unique
  status          String
  createdAt       String
  expiresAt       String
  verifiedAt      String?
}

model Session {
  token     String @id
  userId    String
  requestId String
  issuedAt  String
  expiresAt String
}

model User {
  userId               String @id
  countryCode          String
  phone                String
  normalizedPhone      String @unique
  createdAt            String
  profileFullName      String?
  profileGender        String?
  profileAge           Int?
  profileProfession    String?
  profileUpdatedAt     String?
  onboardingCompleted  Boolean @default(false)
}

model PushToken {
  pushTokenId  String @id
  userId       String
  pushToken    String @unique
  platform     String?
  deviceId     String?
  status       String
  createdAt    String
  updatedAt    String
}

model Meet {
  meetId              String @id
  ownerUserId         String
  status              String
  topicLabel          String?
  matchTimeLabel      String?
  participantIds      String[]
  venueName           String?
  venueAddress        String?
  venueLat            Float?
  venueLng            Float?
  venueManagerName    String?
  venuePhone          String?
  hostReview          String?
  venueHidden         Boolean @default(true)
  venueShareEtaMins   Int?
  commitmentFeePaise  Int @default(0)
  commitmentDeadlineAt String?
  paymentStatus       String?
  paymentId           String?
  matchFoundPushSentAt String?
  createdAt           String
  updatedAt           String
}

model MeetParticipant {
  participantId String @id
  meetId        String
  userId        String?
  name          String
  subtitle      String
  initial       String
  createdAt     String
}

model Payment {
  paymentId    String @id
  meetId       String
  userId       String
  amountPaise  Int
  currency     String
  status       String
  receiptId    String
  confirmedAt  String
  createdAt    String
  updatedAt    String
}

model Feedback {
  feedbackId String @id
  meetId     String
  userId     String
  rating     Int
  note       String?
  createdAt  String
}

model BlockedUser {
  blockId        String @id
  userId         String
  blockedUserId  String
  reason         String?
  createdAt      String
}

model RequestLog {
  id          Int    @id @default(autoincrement())
  time        String
  method      String
  path        String
  statusCode  Int
  durationMs  Int
  remoteAddr  String
  error       String?
}

model MatchRequest {
  requestId         String @id
  userId            String
  availabilityDate  String?
  availabilitySlot  String?
  vibe              String?
  ageMin            Int?
  ageMax            Int?
  genderPreference  String?
  lat               Float?
  lng               Float?
  radiusKm          Int?
  voiceDurationSec  Int?
  voiceIntroId      String?
  voiceStorageUrl   String?
  voiceMimeType     String?
  voiceSizeBytes    Int?
  voiceRecordedAt   String?
  status            String
  score             Float?
  matchedGroupId    String?
  createdAt         String
  updatedAt         String
}

model MatchGroup {
  groupId           String @id
  status            String
  availabilityDate  String?
  availabilitySlot  String?
  vibe              String?
  score             Float?
  createdAt         String
  updatedAt         String
}

model MatchGroupMember {
  memberId          String @id
  groupId           String
  userId            String
  requestId         String
  createdAt         String
}

model MatchEvent {
  eventId           String @id
  requestId         String?
  groupId           String?
  type              String
  message           String?
  payload           String?
  createdAt         String
}
